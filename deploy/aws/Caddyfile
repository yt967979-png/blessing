# Production proxy — Let's Encrypt HTTPS via Cloudflare.
# Install: sudo cp deploy/aws/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

www.blessingpowerguide.in {
	redir https://blessingpowerguide.in{uri} permanent
}

blessingpowerguide.in {
	encode gzip

	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 3
		}
	}


	@uploads path /uploads/*
	handle @uploads {
		root * /opt/blessing/public
		file_server
	}

	@sse path /api/stock/stream /api/orders/stream /api/support/stream
	handle @sse {
		reverse_proxy 127.0.0.1:3000 127.0.0.1:3001 {
			lb_policy round_robin
			lb_try_duration 6s
			flush_interval -1
			header_down X-Proxy-Upstream {upstream_hostport}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000 127.0.0.1:3001 {
			lb_policy round_robin
			lb_try_duration 6s
			health_uri /api/health
			health_interval 10s
			health_timeout 5s
			header_down X-Proxy-Upstream {upstream_hostport}
			transport http {
				keepalive 60s
				keepalive_idle_conns 250
			}
		}
	}


	# If Node is restarting → friendly Updating page (not raw 502)
	handle_errors {
		rewrite * /maintenance.html
		root * /var/www/blessing-maintenance
		file_server
		header Cache-Control "no-store"
		header Retry-After "30"
	}
}
