# =============================================================================
# Blessing Power Guide — /etc/blessing.env (chmod 600)
# Copy this file on the server. NEVER commit real secrets / .env to git.
# =============================================================================

# --- REQUIRED (site will not run safely without these) ---
HOSTING=aws
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/blessing
SESSION_SECRET=min-32-char-random-string-change-me
ADMIN_EMAIL=owner@gmail.com
ADMIN_PASSWORD=change-me-to-a-long-strong-password
# Super Admin (can Make Admin). Defaults to ADMIN_EMAIL if omitted.
SUPER_ADMIN_EMAIL=owner@gmail.com
ADMIN_PHONE=9840418228
ADMIN_NAME=Admin
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Public HTTPS origin (must match Caddy + Google OAuth origins)
PUBLIC_BASE_URL=https://blessingpowerguide.duckdns.org
NEXT_PUBLIC_SITE_URL=https://blessingpowerguide.duckdns.org

# --- REQUIRED FOR LIVE PAYMENTS (Razorpay) ---
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=xxxx
# From Razorpay Dashboard → Webhooks → signing secret
RAZORPAY_WEBHOOK_SECRET=xxxx
# Optional publishable key if you ever need it client-side:
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxx

# --- RECOMMENDED ON LIGHTSAIL ---
RUNTIME_TIER=hobby
APP_REPLICA_COUNT=1
DB_POOL_MAX=3
DB_IDLE_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=8000
DB_QUERY_TIMEOUT_MS=8000
DB_ACQUIRE_RETRIES=2
DB_CONNECT_ROUNDS=1
DB_PING_RETRIES=1
DB_PING_TIMEOUT_MS=4000
DB_READY_TIMEOUT_MS=8000
DB_ENSURE_TIMEOUT_MS=10000
CATALOG_GET_TIMEOUT_MS=8000
DB_TRY_PRIVATE=false
# Local Postgres can LISTEN; set false to enable live order/stock SSE.
# Neon pooler cannot LISTEN — keep true OR set DATABASE_URL_UNPOOLED.
DISABLE_ORDER_LISTEN=false
DISABLE_STOCK_LISTEN=false
KEEP_ALIVE_MS=240000
STOCK_HOLD_TTL_MINUTES=20

# --- OPTIONAL ---
# NEXT_PUBLIC_ADMIN_PHONE=9840418228
# SHOP_GSTIN=
# NEXT_PUBLIC_SHOP_GSTIN=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_UPLOAD_PRESET=
# RESEND_API_KEY=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# ADMIN_ALERT_EMAIL=
# CRON_SECRET=
# ADMIN_FORCE_PASSWORD_RESET=false
# DATABASE_URL_UNPOOLED=
# DATABASE_DIRECT_URL=

# Do not put RAILWAY_* / RENDER_* here.
# WhatsApp = wa.me via ADMIN_PHONE only (no Baileys).
