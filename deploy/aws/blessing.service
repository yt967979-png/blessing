[Unit]
Description=Blessing Power Guide (Next.js + Baileys)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/blessing
# Leading "-" = unit still starts if the file is missing (fail loud in journal via Next).
# File MUST be KEY=value (no "export "), Unix LF line endings (not Windows CRLF).
EnvironmentFile=-/etc/blessing.env
Environment=NODE_ENV=production
Environment=WHATSAPP_SESSION_DIR=/var/lib/blessing/whatsapp_session
# Prefer direct next binary over `npm start` (avoids npm wrapper / PATH quirks).
ExecStart=/usr/bin/node /opt/blessing/node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 3000
Restart=always
RestartSec=5
TimeoutStopSec=30
# Baileys + Next share this process — keep one replica only.
KillMode=mixed

# Soft limits for small Lightsail plans
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
