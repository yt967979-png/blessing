# Copy to /etc/blessing.env on the Lightsail/EC2 host (chmod 600).
# Values from Railway / Neon. Never commit real secrets.
# Helper (masked): powershell -File scripts/export-railway-env-for-render.ps1

# --- Host markers (runtimeProfile / keep-alive) ---
HOSTING=aws
NODE_ENV=production
# Same public origin as NEXT_PUBLIC_SITE_URL (no trailing slash).
# Temporary HTTP smoke test (no domain yet):
# PUBLIC_BASE_URL=http://18.139.220.64
# After DNS + Caddy HTTPS:
PUBLIC_BASE_URL=https://blessingpowerguide.in
# Shop contact phone for floating wa.me chat icon (10 digits or 91…).
ADMIN_PHONE=9840418228
# Optional client-visible override for the message icon:
# NEXT_PUBLIC_ADMIN_PHONE=9840418228

# --- Required ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SESSION_SECRET=min-32-char-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=123456
ADMIN_PHONE=9840418228
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Temporary HTTP smoke test (no domain yet):
# NEXT_PUBLIC_SITE_URL=http://18.139.220.64
# After DNS + Caddy HTTPS, use the real production URL (not Railway):
NEXT_PUBLIC_SITE_URL=https://blessingpowerguide.in

# --- Recommended on Lightsail 1–2 GB + Neon pooler ---
RUNTIME_TIER=hobby
APP_REPLICA_COUNT=1
DB_POOL_MAX=3
DB_IDLE_TIMEOUT_MS=5000
# Fail fast — 30s connects made admin/catalog hang when Neon pooler stalled.
DB_CONNECT_TIMEOUT_MS=8000
DB_QUERY_TIMEOUT_MS=8000
DB_ACQUIRE_RETRIES=2
DB_CONNECT_ROUNDS=1
DB_PING_RETRIES=1
DB_PING_TIMEOUT_MS=4000
DB_READY_TIMEOUT_MS=8000
DB_ENSURE_TIMEOUT_MS=10000
CATALOG_GET_TIMEOUT_MS=8000
DB_TRY_PRIVATE=false
DISABLE_ORDER_LISTEN=true
KEEP_ALIVE_MS=240000

# --- Optional (copy from Railway only if set / needed) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_UPLOAD_PRESET=

# Razorpay (UPI / cards / netbanking). Never commit real keys.
# Paste test or live keys into /etc/blessing.env on the server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signing secret from Razorpay Dashboard → Settings → Webhooks (required for production webhooks).
RAZORPAY_WEBHOOK_SECRET=
# Optional: only if you ever expose the publishable key client-side via env (checkout normally gets key from /api/razorpay).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

RESEND_API_KEY=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# CRON_SECRET=

# Do not copy RAILWAY_* or RENDER_* variables.
# WhatsApp: wa.me shop icon only (ADMIN_PHONE). No Baileys / bot session.
