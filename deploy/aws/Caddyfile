# Normal production proxy — DuckDNS + Let's Encrypt HTTPS.
# Install: sudo cp deploy/aws/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

blessingpowerguide.duckdns.org {
	encode gzip

	@uploads path /uploads/*
	handle @uploads {
		root * /opt/blessing/public
		file_server
	}

	@sse path /api/stock/stream /api/orders/stream
	handle @sse {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	# If Node is restarting → friendly Updating page (not raw 502)
	handle_errors {
		rewrite * /maintenance.html
		root * /var/www/blessing-maintenance
		file_server
		header Cache-Control "no-store"
		header Retry-After "30"
	}
}

