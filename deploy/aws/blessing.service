[Unit]
Description=Blessing Power Guide (Next.js Production Service)
After=network-online.target
Wants=network-online.target
# Allow more rapid restarts after Neon blips / OOM kill before systemd gives up.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/blessing
# Leading "-" = unit still starts if the file is missing (fail loud in journal via Next).
# File MUST be KEY=value (no "export "), Unix LF line endings (not Windows CRLF).
EnvironmentFile=-/etc/blessing.env
Environment=NODE_ENV=production
# Prefer direct next binary over `npm start` (avoids npm wrapper / PATH quirks).
# Fail fast if .next is missing (common after interrupted build / rsync --delete mid-deploy).
ExecStartPre=/usr/bin/test -d /opt/blessing/.next
ExecStart=/usr/bin/node /opt/blessing/node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 3000
Restart=always
RestartSec=5
# Fast stop so `systemctl restart` does not sit on the default ~90s stop timeout.
TimeoutStopSec=15
KillSignal=SIGTERM
KillMode=mixed


# Soft limits for small Lightsail plans
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
