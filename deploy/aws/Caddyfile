# Reverse proxy for Blessing Power Guide on Lightsail.
# Active: DuckDNS + automatic HTTPS (Let's Encrypt).
# Install: sudo cp deploy/aws/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

blessingpowerguide.duckdns.org {
	encode gzip
	reverse_proxy 127.0.0.1:3000
}

# Temporary HTTP by IP only (no HTTPS) — uncomment and comment DuckDNS block if needed:
# :80 {
# 	encode gzip
# 	reverse_proxy 127.0.0.1:3000
# }

# Custom domain later:
# blessingpowerguide.in, www.blessingpowerguide.in {
