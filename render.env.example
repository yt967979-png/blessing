# Copy to Render Dashboard → Environment (values from Railway / Neon).
# Never commit real secrets.
# Helper: powershell -File scripts/export-railway-env-for-render.ps1

# --- Required ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SESSION_SECRET=min-32-char-random-string
ADMIN_EMAIL=you@gmail.com
ADMIN_PASSWORD=change-me
ADMIN_PHONE=9840418228
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# After first Render deploy, use the real *.onrender.com URL (not Railway):
NEXT_PUBLIC_SITE_URL=https://blessing.onrender.com

# --- Optional (copy from Railway only if set / needed) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_UPLOAD_PRESET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# CRON_SECRET=

# Set automatically by render.yaml Blueprint (override only if needed):
# RUNTIME_TIER=hobby
# APP_REPLICA_COUNT=1
# DB_POOL_MAX=5
# DB_IDLE_TIMEOUT_MS=8000
# DB_CONNECT_TIMEOUT_MS=15000
